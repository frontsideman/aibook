generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  subscriptionActive Boolean        @default(false)
  childProfiles      ChildProfile[]
  books              Book[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ChildProfile {
  id        String   @id @default(cuid())
  name      String
  age       Int
  gender    String
  interests String[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum BookStatus {
  DRAFT
  GENERATING
  REVIEW
  COMPLETED
}

enum BookType {
  AI_ADAPTED
  MANUAL
}

enum BookStyle {
  WATERCOLOR
  CARTOON
  REALISTIC
  PIXAR
  SKETCH
  MANGA
  COMIC
}

enum Tone {
  WARM
  EDUCATIONAL
  PLAYFUL
  MAGICAL
  ADVENTUROUS
}

model StoryLibrary {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?
  promptHint  String?
  createdAt   DateTime @default(now())
}

model Book {
  id        String     @id @default(cuid())
  title     String
  status    BookStatus @default(DRAFT)
  type      BookType   @default(AI_ADAPTED)
  style     BookStyle
  tone       Tone?
  parentComments String?
  parentFeedback Json?
  pdfUrl     String?
  approvedAt DateTime?
  pages     Page[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  child     ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([childId])
}

model Page {
  id           String         @id @default(cuid())
  pageNumber   Int
  textContent  String
  illustrations Illustration[]
  book         Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([bookId, pageNumber])
  @@index([bookId])
}

model Illustration {
  id        String   @id @default(cuid())
  url       String?
  prompt    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}
