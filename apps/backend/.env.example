# Copy this file to apps/backend/.env and keep real secrets only in .env.
# Runtime reads apps/backend/.env; .env.example is documentation only.

# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aibook

# Optional
PORT=3001
REDIS_HOST=localhost
REDIS_PORT=6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=test-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MOCK_AUTH=true

LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-chat
