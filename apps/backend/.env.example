# Copy this file to apps/backend/.env and keep real secrets only in .env.
# Runtime reads apps/backend/.env; .env.example is documentation only.
# Backend runs only in Docker; use Docker service names for DATABASE_URL and REDIS_HOST.

# Required
DATABASE_URL=postgresql://user:password@db:5432/aibook?schema=public

# Optional
PORT=3001
REDIS_HOST=redis
REDIS_PORT=6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=test-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MOCK_AUTH=true

LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-chat
LLM_DEFAULT_PROMPT="You are writing an original children's book adaptation. Rely on your knowledge of the classic story as the source tale to recreate its key characters and plot beats. Write a fresh, age-appropriate adaptation that follows the original story structure, but do not copy the source text verbatim. Return 3 to 20 pages."
